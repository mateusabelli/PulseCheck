<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="root_box">
    <property name="orientation">1</property>
    <child>
      <object class="AdwHeaderBar"></object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">1</property>
        <property name="spacing">16</property>
        <property name="margin-bottom">24</property>
        <property name="margin-start">24</property>
        <property name="margin-top">24</property>
        <property name="margin-end">24</property>
        <child>
          <object class="GtkLabel">
            <property name="label">CPU Usage (%)</property>
            <property name="halign">1</property>
          </object>
        </child>
        <child>
          <object class="GtkProgressBar" id="cpu_bar">
            <property name="show-text">true</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">RAM Usage (%)</property>
            <property name="halign">1</property>
            <property name="margin-top">8</property>
          </object>
        </child>
        <child>
          <object class="GtkProgressBar" id="ram_bar">
            <property name="show-text">true</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="stability_label">
            <property name="label">Loading...</property>
            <property name="halign">1</property>
            <property name="margin-top">8</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>